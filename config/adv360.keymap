#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "Kp";
            bindings = <
&kp EQUAL      &kp N1            &kp N2          &kp N3              &kp N4           &kp N5  &trans                                                        &mo 2          &kp N6  &kp N7            &kp N8               &kp N9            &kp N0                &kp MINUS
&kp TAB        &kp Q             &kp W           &kp E               &kp R            &kp T   &none                                                         &none          &kp Y   &kp U             &kp I                &kp O             &kp P                 &kp BSLH
&kp ESC        &hm LEFT_SHIFT A  &hm LEFT_ALT S  &hm LEFT_CONTROL D  &hm LEFT_META F  &kp G   &none      &kp LCTRL      &kp LALT      &kp LGUI   &kp RCTRL  &kp LS(LG(C))  &kp H   &hm RIGHT_META J  &hm RIGHT_CONTROL K  &hm RIGHT_ALT L   &hm RSHIFT SEMICOLON  &kp SQT
&kp LSHFT      &kp Z             &kp X           &kp C               &kp V            &kp B                             &kp HOME      &kp PG_UP                            &kp N   &kp M             &kp COMMA            &kp PERIOD        &kp SLASH             &kp RSHFT
&kp LEFT_META  &kp GRAVE         &caps_word      &kp LEFT            &kp RIGHT                &kp ENTER  &kp BACKSPACE  &mo 2         &mo 1      &kp TAB    &kp SPACE              &kp DOWN          &kp UP               &kp LEFT_BRACKET  &kp RBKT              &mo 1
            >;
        };

        spaces-arrows {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2            &kp F3            &kp F4            &kp F5            &kp F6            &tog 0                                      &mo 2   &kp F7  &kp F8          &kp F9    &kp F10    &kp F11  &kp F12
&trans  &trans            &trans            &trans            &trans            &trans            &none                                       &none   &trans  &trans          &kp UP    &trans     &trans   &trans
&trans  &kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &kp LA(NUMBER_4)  &kp LA(NUMBER_5)  &none   &trans  &trans      &trans  &trans  &none   &trans  &kp LEFT_ARROW  &kp DOWN  &kp RIGHT  &trans   &trans
&trans  &trans            &trans            &trans            &trans            &trans                            &trans      &trans                  &trans  &trans          &trans    &trans     &trans   &trans
&trans  &trans            &trans            &trans            &trans                              &trans  &trans  &trans      &trans  &trans  &trans          &trans          &trans    &trans     &trans   &trans
            >;
        };

        mouse {
            display-name = "Mod";
            bindings = <
&none           &none  &none         &none          &none           &none  &none                                        &trans       &none  &none           &none           &none            &none  &none
&none           &none  &kp LG(LEFT)  &kp LG(RIGHT)  &msc SCRL_UP    &none  &bootloader                                  &bootloader  &none  &none           &mmv MOVE_UP    &none            &none  &none
&studio_unlock  &none  &mkp MB3      &mkp MB2       &mkp MB1        &none  &none        &none  &none      &none  &none  &none        &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&none           &none  &none         &none          &msc SCRL_DOWN  &none                      &none      &none                      &none  &none           &none           &none            &none  &none
&none           &none  &none         &none          &none                  &none        &none  &none      &none  &none  &none               &none           &none           &none            &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
