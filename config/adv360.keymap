#include <dt-bindings/zmk/stp.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "Kp";
            bindings = <
&kp EQUAL      &kp N1     &kp N2    &kp N3     &kp N4      &kp N5  &studio_unlock                                                        &mo 2          &kp N6  &kp N7            &kp N8             &kp N9      &kp N0         &kp MINUS
&kp TAB        &kp Q      &kp W     &kp E      &kp R       &kp T   &none                                                                 &none          &kp Y   &kp U             &kp I              &kp O       &kp P          &kp BSLH
&kp ESC        &kp A      &kp S     &kp D      &kp F       &kp G   &none           &kp LCTRL     &kp LALT      &kp LGUI   &kp RCTRL      &kp LS(LG(C))  &kp H   &kp J             &kp K              &kp L       &kp SEMICOLON  &kp SQT
&kp LSHFT      &kp Z      &kp X     &kp C      &kp V       &kp B                                 &kp HOME      &kp PG_UP                                &kp N   &kp M             &kp COMMA          &kp PERIOD  &kp SLASH      &kp RSHFT
&kp LEFT_META  &kp LCTRL  &kp LALT  &kp GRAVE  &caps_word          &kp ENTER       &lt 2 ESCAPE  &mo 2         &mo 1      &kp BACKSPACE  &lt 1 SPACE            &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp RALT    &kp RCTRL      &kp RIGHT_GUI
            >;
        };

        spaces {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2            &kp F3            &kp F4            &kp F5            &kp F6            &tog 0                                      &mo 2   &kp F7  &kp F8            &kp F9                &kp F10          &kp F11        &kp F12
&trans  &kp C_MUTE        &kp C_VOL_DN      &kp C_VOLUME_UP   &kp C_PP          &trans            &none                                       &none   &trans  &trans            &kp UP_ARROW          &trans           &trans         &trans
&trans  &kp LA(NUMBER_1)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &kp LA(NUMBER_4)  &kp LA(NUMBER_5)  &none   &trans  &trans      &trans  &trans  &none   &trans  &kp LEFT          &kp DOWN_ARROW        &kp RIGHT_ARROW  &kp LG(LS(C))  &trans
&trans  &kp RG(NUMBER_1)  &kp RG(NUMBER_2)  &kp RG(NUMBER_3)  &kp RG(NUMBER_4)  &kp RG(NUMBER_5)                  &trans      &trans                  &trans  &kp LA(LG(DOWN))  &kp LA(LG(UP_ARROW))  &trans           &trans         &trans
&trans  &trans            &trans            &trans            &trans                              &mo 3   &trans  &trans      &trans  &trans  &trans          &trans            &trans                &trans           &trans         &trans
            >;
        };

        mouse {
            display-name = "Mod";
            bindings = <
&none           &none  &none         &none          &none           &none  &none                                        &trans       &none  &none           &none           &none            &none  &none
&none           &none  &kp LG(LEFT)  &kp LG(RIGHT)  &msc SCRL_UP    &none  &bootloader                                  &bootloader  &none  &none           &mmv MOVE_UP    &none            &none  &none
&studio_unlock  &none  &mkp MB3      &mkp MB2       &mkp MB1        &none  &none        &none  &none      &none  &none  &none        &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&none           &none  &none         &none          &msc SCRL_DOWN  &none                      &none      &none                      &none  &none           &none           &none            &none  &none
&none           &none  &none         &none          &none                  &none        &none  &none      &none  &none  &none               &none           &none           &none            &none  &none
            >;
        };

        Other {
            bindings = <
&trans  &trans     &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LA(S)  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
